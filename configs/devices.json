{
  "control_addr": ":8080",
  "devices": [
    {
      "id": "device-1",
      "name": "Mock Device 1 (JSON)",
      "protocol": "json",
      "listen_addr": ":9000",
      "delay_ms": 0,
      "responses": {
        "ping": "pong",
        "status": { "ok": true }
      },
      "behaviors": {
        "get_counter": { "type": "state_get", "state_key": "counter" },
        "inc_counter": { "type": "state_set", "state_key": "counter" },
        "boom": { "type": "fault", "fault": "malformed" }
      }
    },
    {
      "id": "device-2",
      "name": "Mock Device 2 (JSON)",
      "protocol": "json",
      "listen_addr": ":9001",
      "delay_ms": 50,
      "responses": {
        "ping": "pong2"
      }
    },
    {
      "id": "scpi-dev",
      "name": "SCPI Instrument",
      "protocol": "scpi",
      "listen_addr": ":9002",
      "responses": {
        "*IDN?": "ACME,MODEL1,12345,1.0",
        "MEAS:VOLT?": 3.14,
        "MEAS:CURR?": 0.42
      },
      "behaviors": {
        "*RST": { "type": "fault", "fault": "drop" }
      }
    },
    {
      "id": "telnet-dev",
      "name": "Telnet Console",
      "protocol": "telnet",
      "listen_addr": ":9003",
      "responses": {
        "HELLO": "HI",
        "STATUS": "OK"
      }
    },
    {
      "id": "raw-dev",
      "name": "Raw Text Device",
      "protocol": "raw",
      "listen_addr": ":9004",
      "responses": {
        "PING": "PONG"
      }
    }
  ]
}